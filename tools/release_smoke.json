{
  "scope": "Fresh CPU dependencies, real JSONL preprocessing and single-class rejection, live Gradio HTTP; no model training/detox inference",
  "requirements": "requirements.txt",
  "command_timeout": 1000,
  "commands": [
    {
      "argv": [
        "{python}",
        "tools/check_preprocess.py"
      ]
    }
  ],
  "servers": [
    {
      "argv": [
        "{python}",
        "app_ui_2.py"
      ],
      "env": {
        "APP_HOST": "127.0.0.1",
        "APP_PORT": "{port}",
        "GRADIO_ANALYTICS_ENABLED": "False"
      },
      "checks": [
        {
          "path": "/",
          "text_contains": "<html"
        }
      ]
    }
  ]
}
